APP_NAME=MarketHub
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.invalid
FRONTEND_URL=https://example.invalid
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=markethub_demo
DB_USERNAME=markethub
DB_PASSWORD=
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=example.invalid
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=1900
CACHE_STORE=redis
CACHE_PREFIX=markethub_demo_
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1
PUBLIC_DEMO_ENABLED=true
PUBLIC_DEMO_DATABASE=markethub_demo
MAIL_MAILER=log
